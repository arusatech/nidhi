{
  "name": "@annadata/nidhi",
  "version": "0.1.0",
  "description": "Local-first Nidhi wallet: device keys, offline receipts, Fabric gateway client, US/IN fiat corridor bridge helpers. No central user ledger.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./peer": {
      "types": "./dist/peer.d.ts",
      "import": {
        "types": "./dist/peer.d.ts",
        "default": "./dist/peer.js"
      },
      "require": {
        "types": "./dist/peer.d.cts",
        "default": "./dist/peer.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "docs",
    "chaincode",
    "network"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "test:chaincode": "go test -C chaincode/nidhi ./..."
  },
  "dependencies": {
    "@noble/curves": "^1.9.0",
    "@noble/hashes": "^1.8.0"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  },
  "peerDependencies": {
    "@grpc/grpc-js": "^1.12.0",
    "@hyperledger/fabric-gateway": "^1.8.0"
  },
  "peerDependenciesMeta": {
    "@grpc/grpc-js": { "optional": true },
    "@hyperledger/fabric-gateway": { "optional": true }
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "private": false
}
